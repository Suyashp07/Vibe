# =========================================================
# VIBE BY SWANIKI — ENVIRONMENT CONFIGURATION
# =========================================================

# 1. Supabase (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Google Gemini 1.5 Flash (Get from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# 3. Transactional Emails (Choose Option A or Option B)

# OPTION A (Recommended: 100% Free, NO Domain Needed, Sends to ANYONE in the world):
# Create a 16-letter App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password

# OPTION B: Resend (https://resend.com)
# (Requires verified domain in Resend to send to anyone, or delivers to account owner on free tier)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Vibe by Swaniki <onboarding@resend.dev>

# 4. App URL (e.g. http://localhost:3000 or https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Telegram Ingestion Bot (Get token from @BotFather, user ID from @userinfobot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-numeric-telegram-id

# 6. Vibe Host ↔ Guest Communication Gateway (Telegram Host Channel)
# Supergroup chat ID where forum topics are created for host-guest conversations
TELEGRAM_HOST_CHAT_ID=-100xxxxxxxxxx
# Optional webhook secret token for security verification (sent by Telegram in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your-secret-webhook-token

# 7. Vibe Host ↔ Guest Communication Gateway (WhatsApp Option B: Free QR-Code Bridge)
# URL where your WhatsApp Web bridge is running (default: http://localhost:3002)
WHATSAPP_BRIDGE_URL=http://localhost:3002
# Shared bearer secret between Vibe backend and WhatsApp bridge
WHATSAPP_BRIDGE_SECRET=vibe_wa_sec_your_random_secret
# Target WhatsApp number of the host (country code + phone number without + or spaces, e.g. 919876543210)
WHATSAPP_HOST_PHONE=919876543210
# Webhook secret verified at /api/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=vibe_wa_sec_your_random_secret

