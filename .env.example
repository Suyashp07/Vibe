# =========================================================
# VIBE BY SWANIKI — ENVIRONMENT CONFIGURATION
# =========================================================

# 1. Supabase (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Google Gemini 1.5 Flash (Get from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# 3. Optional: Resend (For white-labeled email confirmations)
RESEND_API_KEY=your-resend-api-key

# 4. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
