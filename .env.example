# =========================================================
# VIBE BY SWANIKI — ENVIRONMENT CONFIGURATION
# =========================================================

# 1. Supabase (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Google Gemini 1.5 Flash (Get from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# 3. Transactional Emails: Resend (https://resend.com)
# Provides automated event creation emails to organizers and digital boarding passes with QR to guests
RESEND_API_KEY=your-resend-api-key
# Default sender address (onboarding@resend.dev works out-of-the-box on Resend free tier)
EMAIL_FROM=Vibe by Swaniki <onboarding@resend.dev>

# 4. App URL (e.g. http://localhost:3000 or https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
